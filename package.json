{
  "name": "@hubspot/quote-dev-sdk",
  "version": "0.3.0",
  "description": "TypeScript types and React hooks for HubSpot Commerce Hub quote templates.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./events/window": {
      "types": "./dist/events/window.d.ts",
      "import": "./dist/events/window.js",
      "require": "./dist/events/window.js",
      "default": "./dist/events/window.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "release": "tsx ./scripts/release.ts release",
    "sync-to-public": "tsx ./scripts/sync-to-public.ts repo-sync"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hubspot/npm-scripts": "0.3.0",
    "@types/node": "20.19.39",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
